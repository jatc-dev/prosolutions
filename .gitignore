# Dependencias
node_modules/
.pnpm-store/

# Builds y compilados
dist/
build/
.next/
out/

# Excepción: packages/ui se consume precompilado por apps/procv/frontend
# en builds aislados (Render/Docker), donde el repo se clona sin ejecutar
