{
  "name": "prosolutions-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/procv/frontend",
    "apps/procv/backend",
    "apps/identity",
    "packages/*"
  ],
  "scripts": {
    "dev:procv": "npm run dev --workspace=apps/procv",
    "dev:projobs": "npm run dev --workspace=apps/projobs",
    "dev:core": "npm run dev --workspace=apps/core",
    "dev:identity": "npm run dev --workspace=apps/identity",
    "build:ui": "npm run build --workspace=packages/ui",
    "build:procv": "npm run build:ui && npm --prefix apps/procv run build",
    "build:projobs": "npm run build --workspace=apps/projobs",
    "build:core": "npm run build:ui && npm --prefix apps/core run build"
  },
  "dependencies": {
    "@supabase/server": "^1.9.2",
    "@types/pg": "8.23.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/pdf-parse": "^1.1.5"
  }
}
