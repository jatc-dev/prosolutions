# ==============================================
# ProCV Platform - Environment Template
# ==============================================
# Copy this file to .env and fill in your values
# .env is gitignored and should NEVER be committed

# Render backend: https://procv.prosolutions.page
# Render frontend: https://procv.prosolutions.page

# Server
PORT=4000
FRONTEND_URL="https://procv.prosolutions.page"

# Identity service (central authentication)
IDENTITY_URL=https://identity.prosolutions.page
IDENTITY_ISSUER=https://identity.prosolutions.page
IDENTITY_AUDIENCE=prosolutions-api

# Restricted NOLOGIN PostgreSQL policy role assumed inside each transaction.
# Production: procv_app | Staging: procv_app_stage
PROCV_DB_ROLE=procv_app

# JWT Authentication (shared secret with Identity)
# Must match IDENTITY_JWT_SECRET from Identity service.
JWT_SECRET=your-jwt-secret-at-least-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Health check DB probe timeout (ms)
HEALTH_DB_TIMEOUT_MS=2500

# Database (Supabase - ProCV CVs data)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/procvplatform?schema=public"

# Session idle timeout (minutes, default: 30)
SESSION_IDLE_TIMEOUT_MINUTES=30

# Cookie settings — SSO across *.prosolutions.page subdomains
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=.prosolutions.page

# CORS — allowed origins for credentialed requests
CORS_ORIGIN=https://procv.prosolutions.page,https://projobs.prosolutions.page

# Email
# ---- Development (no SMTP vars configured) ----
# Emails are sent through Ethereal (nodemailer test account).
#
# ---- Production: transactional provider (recommended) ----
# SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=2525, SMTP_SECURE=false
# SMTP_USER=apikey, SMTP_PASS=SG.xxxx, SMTP_FROM=no-responder@prosolutions.page
# NOTE for Render: outbound ports 25, 465 and 587 are blocked. Use port 2525.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=no-responder@prosolutions.page
