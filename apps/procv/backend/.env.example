# ==============================================
# ProCV Platform - Environment Template
# ==============================================
# Copy this file to .env and fill in your values
# .env is gitignored and should NEVER be committed

# Server
PORT=4000
FRONTEND_URL="http://localhost:5173"

# JWT Authentication (use openssl rand -base64 32 in production)
JWT_SECRET=your-jwt-secret-at-least-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Health check DB probe timeout (ms)
HEALTH_DB_TIMEOUT_MS=2500

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/procvplatform?schema=public"

# Session idle timeout (minutes, default: 30)
SESSION_IDLE_TIMEOUT_MINUTES=30

# Email
# ---- Development (no SMTP vars configured) ----
# Emails are sent through Ethereal (nodemailer test account): the real rendered
# message opens at the "Ethereal preview" URL logged by the backend, and the
# verification/reset URL is always logged too, so no inbox is needed.
#
# ---- Development with real delivery ----
# Point SMTP_* at a local mail catcher (Mailpit/MailHog on localhost:1025) or
# at the real provider below.
#
# ---- Production: transactional provider (recommended) ----
# SendGrid: Settings -> API Keys -> Create API Key (permission "Mail Send").
# The username is literally the string "apikey". SMTP_FROM must be a verified
# sender identity (Single Sender or domain authentication) or sends fail 403.
# NOTE for Render: outbound ports 25, 465 and 587 are blocked by the platform.
# Use port 2525 (STARTTLS, SMTP_SECURE=false). If that also times out, the
# fallback is the SendGrid Web API over HTTPS (port 443).
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=no-responder@tudominio.com
#
# ---- Production (Gmail SMTP, free, works with App Passwords) ----
# Set up at: https://myaccount.google.com/apppasswords
# Requires 2FA enabled on your Gmail account
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=your-email@gmail.com
# SMTP_SECURE=false
