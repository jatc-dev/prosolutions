# ProCV backend — local development template
# Never commit real .env files, passwords, tokens or connection strings.
# Production procedure: docs/deployment/ENVIRONMENT_VARIABLES.md

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ProIdentity token verification
IDENTITY_URL=http://localhost:4001
# Enable only when using a trusted remote Identity service; production always verifies JWTs locally.
IDENTITY_INTROSPECTION_ONLY=false
IDENTITY_ISSUER=https://identity.prosolutions.page
IDENTITY_AUDIENCE=prosolutions-api
IDENTITY_JWT_SECRET=replace-with-a-random-development-secret-of-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Local PostgreSQL only. Production uses Neon and a restricted runtime login.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/procvplatform?schema=public

# Required for signed RLS context: exactly 32 bytes encoded as 64 hex characters.
# Production value must match key id v1 in procv_private.context_signing_keys.
# Never rotate this value without a coordinated database verifier rotation.
PROCV_RLS_CONTEXT_KEY=

# Separate application-level admin pool. This is NOT the DDL/migration connection.
# Production login must be procv_admin_login and must only be used for admin context.
PROCV_ADMIN_DATABASE_URL=

# Only for a one-off migration process: set DIRECT_DATABASE_URL to the approved
# direct DDL connection and map it to DATABASE_URL for Prisma. Do not persist it
# in the runtime service: config.ts prefers DIRECT_DATABASE_URL over DATABASE_URL.
# DIRECT_DATABASE_URL=

SESSION_IDLE_TIMEOUT_MINUTES=30
HEALTH_DB_TIMEOUT_MS=2500
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Production SMTP credentials belong only in the provider's secret manager.
# Render outbound SMTP restrictions may require the provider's supported port.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ProIdentity public keys (defaults to ${IDENTITY_URL}/.well-known/jwks.json).
# Once ProIdentity signs with ES256, remove IDENTITY_JWT_SECRET from ProCV.
# IDENTITY_JWKS_URL=
# CSRF signing key (defaults to an HMAC derivation of PROCV_RLS_CONTEXT_KEY).
# PROCV_CSRF_SECRET=

# AI CV assistant (Claude). Leave empty to disable the assistant.
ANTHROPIC_API_KEY=
# Suggestions per user per day.
AI_DAILY_LIMIT=30
