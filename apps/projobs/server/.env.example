# ProJobs API; server-side secrets only
NODE_ENV=production
PORT=5176
IDENTITY_URL=https://identity.prosolutions.page
IDENTITY_JWT_SECRET=replace-with-the-same-secret-configured-in-ProIdentity
IDENTITY_ISSUER=https://identity.prosolutions.page
IDENTITY_AUDIENCE=prosolutions-api
# Dedicated ProJobs PostgreSQL only. Login must not own tables or have SUPERUSER/BYPASSRLS.
# Grant membership in the restricted NOLOGIN role projobs_api after applying the migration.
DATABASE_URL=postgresql://projobs_runtime:replace-me@your-postgres-host/projobs?sslmode=require
CORS_ORIGIN=https://projobs.prosolutions.page,https://prosolutions.page
