# ProJobs API v2 — environment template. Never commit real values.

NODE_ENV=development
PORT=5176

# Leave DATABASE_URL empty in local development to use an in-memory PostgreSQL
# (PGlite) with demo data. Production: pooled Neon URL for the restricted login
# (projobs_runtime), which must be a member of the NOLOGIN role projobs_api.
DATABASE_URL=
# Role assumed per transaction (defaults to projobs_api in production).
# PROJOBS_DB_RUNTIME_ROLE=projobs_api
# PG_POOL_MAX=5

# One-off migrations/seeds only (owner/direct connection). Never set on the runtime service.
# MIGRATION_DATABASE_URL=
# SEED_RECRUITER_ID=<ProIdentity user id that will own the demo companies>

# ProIdentity token verification (same secret/issuer/audience as the other modules).
IDENTITY_JWT_SECRET=
IDENTITY_ISSUER=https://identity.prosolutions.page
IDENTITY_AUDIENCE=prosolutions-api

# ProCV API used for one-click apply (called with the candidate's own token).
PROCV_API_URL=http://localhost:4000
# PROCV_TIMEOUT_MS=6000

# Browser origins allowed by CORS (comma separated).
CORS_ORIGIN=http://localhost:5175

# Enables GET /internal/events for other ProSolutions modules (>= 32 chars).
# PROJOBS_INTERNAL_TOKEN=

# ProIdentity public keys for ES256 access tokens (preferred over the shared
# IDENTITY_JWT_SECRET, which should be removed once JWKS is configured).
IDENTITY_JWKS_URL=https://identity.prosolutions.page/.well-known/jwks.json

# Public URLs used in emails, sitemap and unsubscribe links.
PUBLIC_WEB_URL=https://projobs.prosolutions.page
PUBLIC_API_URL=https://projobs-api-0clw.onrender.com

# Transactional emails and job alerts. Without SMTP they are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ProJobs <no-reply@prosolutions.page>
