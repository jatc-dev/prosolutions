# ProSolutions ProJobs API — server-only environment variables
NODE_ENV=production
PORT=5176

# Central authentication authority
IDENTITY_URL=https://identity.prosolutions.page
IDENTITY_JWT_SECRET=replace-with-the-same-secret-configured-in-ProIdentity
IDENTITY_ISSUER=https://identity.prosolutions.page
IDENTITY_AUDIENCE=prosolutions-api

# Dedicated ProJobs Supabase project only (never ProIdentity or ProCV).
# Keep the service-role key on the API server; never expose it to the browser.
PROJOBS_SUPABASE_URL=https://your-projobs-project.supabase.co
PROJOBS_SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Browser origin allowed by the API
CORS_ORIGIN=https://projobs.prosolutions.page,https://prosolutions.page
