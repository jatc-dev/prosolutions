# ProSolutions ProJobs Server — Environment configuration
# Copy to .env and adjust for your environment.
# Render service: https://projobs.prosolutions.page

NODE_ENV=production
PORT=5176

# Identity service (central authentication)
IDENTITY_URL=https://identity.prosolutions.page

# JWT — Shared secret with Identity (must match IDENTITY_JWT_SECRET)
IDENTITY_JWT_SECRET=change-me-for-development-only-generate-a-strong-secret

# OIDC / token claims
IDENTITY_ISSUER=https://identity.prosolutions.page
IDENTITY_AUDIENCE=projobs-api

# Cookie settings — SSO across *.prosolutions.page subdomains
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=.prosolutions.page

# CORS — allowed origins for credentialed requests
CORS_ORIGIN=https://projobs.prosolutions.page,https://procv.prosolutions.page

# Rate limiting
DISABLE_RATE_LIMIT=false
