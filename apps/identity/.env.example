# ProIdentity — Environment configuration
# Copy to .env and adjust for your environment.
# Render service: https://identity.prosolutions.page

NODE_ENV=production
PORT=4001

# Database (Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prosolutions_identity?schema=public"

# JWT — Identity ecosystem secret (shared across modules for token validation)
# Generate with: openssl rand -base64 32
IDENTITY_JWT_SECRET=change-me-for-development-only-generate-a-strong-secret
IDENTITY_JWT_EXPIRES_IN=15m
IDENTITY_JWT_REFRESH_EXPIRES_IN=7d

# OIDC / token claims
IDENTITY_ISSUER=https://identity.prosolutions.page
IDENTITY_AUDIENCE=prosolutions-api

# Frontend (for email verification / reset links)
FRONTEND_URL=https://procv.prosolutions.page

# Cookie settings — SSO across *.prosolutions.page subdomains
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=.prosolutions.page

# CORS — allowed origins for credentialed requests
ALLOWED_ORIGINS=https://procv-platform.onrender.com,https://procv.prosolutions.page,http://localhost:3000,http://localhost:5173

# SMTP (email verification / password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@prosolutions.page

# Rate limiting
DISABLE_RATE_LIMIT=false

# Session idle timeout (minutes)
SESSION_IDLE_TIMEOUT_MINUTES=30

