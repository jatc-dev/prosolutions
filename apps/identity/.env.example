# ProIdentity — Environment configuration
# Copy to .env and adjust for your environment.
# Render service: https://identity.prosolutions.page

NODE_ENV=production
PORT=4001

# Database (Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prosolutions_identity?schema=public"

# JWT — Identity ecosystem secret (shared across modules for token validation)
# Generate with: openssl rand -base64 32
IDENTITY_JWT_SECRET=reemplaza-por-un-secreto-fuerte-en-produccion
IDENTITY_JWT_EXPIRES_IN=15m
IDENTITY_JWT_REFRESH_EXPIRES_IN=7d

# OIDC / token claims
IDENTITY_ISSUER=https://identity.prosolutions.page
IDENTITY_AUDIENCE=prosolutions-api

# Frontend (for email verification / reset links)
FRONTEND_URL=https://procv.prosolutions.page

# Cookie settings — SSO across *.prosolutions.page subdomains
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=.prosolutions.page

# CORS — allowed origins for credentialed requests
ALLOWED_ORIGINS=https://prosolutions.page,https://procv-platform.onrender.com,https://procv.prosolutions.page,http://localhost:3000,http://localhost:5173

# SMTP (email verification / password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@prosolutions.page

# Rate limiting
DISABLE_RATE_LIMIT=false

# Session idle timeout (minutes)
SESSION_IDLE_TIMEOUT_MINUTES=30


# Asymmetric access-token signing (ES256). Generate with:
#   node scripts/generate-jwt-keypair.mjs
# The private key lives ONLY in ProIdentity. Other services verify with
# /.well-known/jwks.json. While unset, access tokens are signed with HS256.
IDENTITY_JWT_PRIVATE_KEY=
IDENTITY_JWT_KID=
# Previous public key (base64 PEM) to keep accepting tokens after a key rotation.
IDENTITY_JWT_PREVIOUS_PUBLIC_KEY=
# Migration window: also accept HS256 access tokens once ES256 is configured.
IDENTITY_JWT_ACCEPT_HS256=false

# Google sign-in (OAuth 2.0 / OIDC). Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=https://identity.prosolutions.page/api/auth/google/callback
# Where failed OAuth attempts land.
CORE_LOGIN_URL=https://prosolutions.page/login

# Contact form / Habeas Data inbox (requests are stored even when unset).
CONTACT_INBOX=contacto@prosolutions.page
# ProAdmin -> ProJobs moderation (service-to-service, never exposed to browsers).
PROJOBS_API_URL=https://projobs-api-0clw.onrender.com
PROJOBS_INTERNAL_TOKEN=
