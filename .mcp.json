{
  "mcpServers": {
    "neon": {
      "type": "http",
      "url": "https://mcp.neon.tech/mcp?readonly=true",
      "headers": {
        "Authorization": "Bearer ${NEON_API_KEY}"
      }
    },
    "render-psl-pcv": {
      "type": "http",
      "url": "https://mcp.render.com/mcp",
      "headers": {
        "Authorization": "Bearer ${RENDER_API_KEY_PSL_PCV}"
      }
    },
    "render-pid-pjb": {
      "type": "http",
      "url": "https://mcp.render.com/mcp",
      "headers": {
        "Authorization": "Bearer ${RENDER_API_KEY_PID_PJB}"
      }
    }
  }
}
